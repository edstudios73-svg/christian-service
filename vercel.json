{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>mediateam|youth|prayer|ushers|choir|evangelism)\\.christianservicechurch\\.org"
        }
      ],
      "destination": "/m/:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/virtuous-women",
      "destination": "/api/share?page=share-virtuous-women"
    },
    {
      "source": "/children",
      "destination": "/api/share?page=share-children"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>mediateam|youth|prayer|ushers|choir|evangelism)\\.christianservicechurch\\.org"
        }
      ],
      "destination": "/ministry-admin.html"
    },
    {
      "source": "/m/mediateam",
      "destination": "/api/share?page=ministry-mediateam"
    },
    {
      "source": "/m/youth",
      "destination": "/api/share?page=ministry-youth"
    },
    {
      "source": "/m/prayer",
      "destination": "/api/share?page=ministry-prayer"
    },
    {
      "source": "/m/ushers",
      "destination": "/api/share?page=ministry-ushers"
    },
    {
      "source": "/m/choir",
      "destination": "/api/share?page=ministry-choir"
    },
    {
      "source": "/m/evangelism",
      "destination": "/api/share?page=ministry-evangelism"
    },
    {
      "source": "/m/:slug",
      "destination": "/ministry.html"
    },
    {
      "source": "/m/:slug/admin",
      "destination": "/ministry-admin.html"
    },
    {
      "source": "/subscribe",
      "destination": "/subscribe.html"
    },
    {
      "source": "/sms",
      "destination": "/subscribe.html"
    }
  ],
  "functions": {
    "api/share.js": {
      "includeFiles": "{ministry-*.html,share-*.html}"
    }
  }
}
