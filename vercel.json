{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>mediateam|youth|prayer|ushers|choir|evangelism)\\.christianservicechurch\\.org"
        }
      ],
      "destination": "/m/:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>mediateam|youth|prayer|ushers|choir|evangelism)\\.christianservicechurch\\.org"
        }
      ],
      "destination": "/ministry-admin.html"
    },
    {
      "source": "/m/mediateam",
      "destination": "/ministry-mediateam.html"
    },
    {
      "source": "/m/youth",
      "destination": "/ministry-youth.html"
    },
    {
      "source": "/m/prayer",
      "destination": "/ministry-prayer.html"
    },
    {
      "source": "/m/ushers",
      "destination": "/ministry-ushers.html"
    },
    {
      "source": "/m/choir",
      "destination": "/ministry-choir.html"
    },
    {
      "source": "/m/evangelism",
      "destination": "/ministry-evangelism.html"
    },
    {
      "source": "/m/:slug",
      "destination": "/ministry.html"
    },
    {
      "source": "/m/:slug/admin",
      "destination": "/ministry-admin.html"
    },
    {
      "source": "/subscribe",
      "destination": "/subscribe.html"
    },
    {
      "source": "/sms",
      "destination": "/subscribe.html"
    }
  ]
}
